{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.texboobcat.tessellate.fabric.TessellateFabric"
    ],
    "client": [
      "org.texboobcat.tessellate.fabric.TessellateFabricClient"
    ],
    "fabric-gametest": [
      "org.texboobcat.tessellate.fabric.gametest.RegionalChunkGameTests"
    ]
  },
  "mixins": [
    "tessellate.mixins.json",
    "tessellate.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "architectury": ">=${architectury_api_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  },
  "custom": {
    "lithium:options": {
      "mixin.alloc.chunk_random": false,
      "mixin.entity.inactive_navigations": false
    }
  }
}
